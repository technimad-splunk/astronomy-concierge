# =============================================================================
# local-agent-galileo — environment template
# =============================================================================
# Copy this file to `.env` and fill in your tokens:
#
#     cp .env.example .env
#
# `.env` is gitignored; this `.env.example` is committed. Use PLACEHOLDER values
# only here — never commit real secrets (repo rule: no hardcoded credentials).
# =============================================================================

# -----------------------------------------------------------------------------
# Model provider (the two-runtime switch — demo-design §8.1-8.2, decision D6)
# -----------------------------------------------------------------------------
# Selects which LangChain chat model the concierge uses.
MODEL_PROVIDER=ollama                      # ollama | openai

# --- Ollama (Apple-silicon laptop runtime; run Ollama NATIVELY, not in Docker) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- OpenAI (EC2 runtime) ---
OPENAI_API_KEY=                            # required only when MODEL_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini

# Sampling temperature for the chat model. 0.0 maximizes tool-calling reliability
# for the agent loop (recommended). Raise for a chattier persona.
MODEL_TEMPERATURE=0.0

# -----------------------------------------------------------------------------
# Concierge agent (Phase 2)
# -----------------------------------------------------------------------------
# Base URL of the Astronomy Shop frontend-proxy the agent calls as its tools.
# The agent runs on the host, so it uses the public storefront API at :8080.
STORE_BASE_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Web interfaces (Phase 7)
# -----------------------------------------------------------------------------
# Standalone shopper-facing concierge web app (this worker's slice).
CONCIERGE_WEB_PORT=8090
# Reserved for the SE-facing control-plane web app (parallel worker slice).
CONTROL_PLANE_WEB_PORT=8099
# Storefront origin allowed by concierge CORS.
WEB_ALLOWED_ORIGIN=http://localhost:8080
# Public URL where browsers should reach the concierge API/web app.
CONCIERGE_API_URL=http://localhost:8090

# -----------------------------------------------------------------------------
# Galileo AI (the hero — AI/agent intelligence backend)
# -----------------------------------------------------------------------------
GALILEO_API_KEY=                           # enterprise API key (capture out-of-band)
GALILEO_PROJECT=local-agent-galileo
GALILEO_LOG_STREAM=dev
# Set for enterprise / custom / self-hosted deployments. Leave blank for the
# default SaaS console. Use the OTLP ingest endpoint as applicable for the
# single-instrument / dual-fan-out export.
GALILEO_CONSOLE_URL=
# Galileo export path for the concierge:
#   unset/0 -> GalileoCallback (default; the SDK's first-class LangChain/LangGraph
#              path — robust on enterprise/multitenant, gives Sessions->Traces->Spans).
#   1       -> pure OTLP via GalileoSpanProcessor (true "instrument once -> two
#              OTLP exporters"; only enable if your tenant's /otel/traces endpoint
#              accepts it — some multitenant endpoints return 404).
GALILEO_OTEL_EXPORT=0

# -----------------------------------------------------------------------------
# Splunk Observability Cloud (the operational backdrop)
# -----------------------------------------------------------------------------
SPLUNK_ACCESS_TOKEN=                       # Splunk Observability access token
SPLUNK_REALM=us1                           # e.g. us0 | us1 | eu0 | ap0
# The concierge exports OTLP to the LOCAL Splunk OpenTelemetry Collector, which
# forwards to Splunk Observability using SPLUNK_ACCESS_TOKEN + SPLUNK_REALM (above).
# The OTel SDK already defaults to the local collector (localhost:4317), so you
# normally DO NOT need to set this — leave it unset. Uncomment only to override the
# collector endpoint. Transport is OTLP only — never the deprecated `sapm` exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Containerized concierge profile (docker compose network) should override this to:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=astronomy-concierge
# APM environment the concierge joins — keep equal to the store's so the agent
# and the shop correlate in Splunk APM. (The collector also upserts this on the
# Splunk pipeline.) Set DEPLOYMENT_ENVIRONMENT to override; default below.
DEPLOYMENT_ENVIRONMENT=local-agent-galileo
# Set to 1 to disable the Splunk OTLP exporter (e.g. running the agent without
# the stage up). Leave unset/0 for the normal dual-fan-out.
SPLUNK_OTLP_DISABLED=0

# --- Splunk AI Agent Monitoring (GenAI semantic conventions) -----------------
# The concierge is instrumented with the OpenLLMetry/Traceloop LangChain
# instrumentor, which emits OTel GenAI conventions (gen_ai.* spans) AND GenAI
# histogram metrics. These are the knobs from Splunk's "Set up AI Agent
# Monitoring" doc; the agent also applies them as defaults if unset. Histogram
# metrics + gen_ai.* spans are what light up APM > AI agents / AI trace data.
#   span_metric -> emit BOTH spans and metrics (token usage + operation duration)
OTEL_INSTRUMENTATION_GENAI_EMITTERS=span_metric
#   SPAN_ONLY   -> capture prompt/response content on spans (not as log events)
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=SPAN_ONLY
#   delta       -> metric temporality REQUIRED by Splunk AI Agent Monitoring
OTEL_EXPORTER_OTLP_METRICS_TEMPORALITY_PREFERENCE=delta
# TRACELOOP_TRACE_CONTENT=true is the lever that makes the Traceloop LangChain
# instrumentor put the actual prompt/completion content on LLM spans. Without it,
# Splunk AI Agent Monitoring shows "No parsable message event found"; with it on,
# the Traceloop->GenAI translator (see below) reconstructs the conversation into
# gen_ai.input.messages / gen_ai.output.messages that the UI renders.
TRACELOOP_TRACE_CONTENT=true
# Splunk's Traceloop->GenAI translator promotes the agent/workflow structure into
# the OTel GenAI entity model (gen_ai.agent.*/gen_ai.workflow.*) and reconstructs
# the conversation. It is ON by default; set to 0 to remove it (then only the raw
# Traceloop span shape is exported and AI Agent Monitoring will not render agents).
SPLUNK_GENAI_TRANSLATOR=1
# Diagnostic (off by default): set to 1 to also dump every GenAI metric data
# point (incl. the gen_ai.client.* histograms) to the agent's stdout, to prove
# the histograms are produced/flushed locally. Does not affect the OTLP export.
GENAI_METRICS_CONSOLE_DEBUG=0

# -----------------------------------------------------------------------------
# Scenario harness / control plane (Phase 3)
# -----------------------------------------------------------------------------
# Threshold below which a Galileo "low" quality metric (e.g. Context Adherence,
# Tool Selection Quality) is treated as having fired, used by the expected_signals
# auto-verification hook (control_plane verify). Metrics are 0..1; 0.5 is a sane
# default. Raise to make verification stricter.
GALILEO_METRIC_LOW_THRESHOLD=0.5
# Advanced overrides (normally leave unset — sensible defaults are derived from
# the repo layout):
#   SCENARIOS_DIR       — where drop-in scenario folders live (default: scenarios/)
#   HARNESS_STATE_DIR   — harness runtime state, e.g. saved flag variants for reset
#   FLAGD_CONFIG_PATH   — the vendored demo's flagd config the feature_flag trigger edits
#   AGENT_OVERLAY_DIR   — the agent overlay seam rag_corpus/prompt_overlay/tool_fault write to
